# Copier vers .env et adapter (ne pas committer les secrets réels).
# Chargé automatiquement au démarrage (dotenv dans server.js).

JWT_SECRET=changez_moi_en_production
# Access token court (défaut 15m). JWT_EXPIRES_IN reste accepté comme alias.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Alias historique (ignoré si JWT_ACCESS_EXPIRES_IN est défini)
JWT_EXPIRES_IN=15m

# Rate limit distribué (optionnel — npm install ioredis)
# REDIS_URL=redis://127.0.0.1:6379

# Chat — rétention et pagination
# CHAT_RETENTION_DAYS=365
# CHAT_MAX_MESSAGES_PER_CONVERSATION=2000
# CHAT_MAX_TOTAL_MESSAGES=50000
# CHAT_MESSAGES_PAGE_LIMIT=80
# CHAT_SOCKET_MSG_MAX_PER_MIN=30

# ─── Chatbot orientation (RAG) ───
# Fonctionne SANS clé IA (réponses ancrées sur le catalogue).
# Clé optionnelle pour reformuler uniquement les faits déjà récupérés :
# OPENAI_API_KEY=
# CHATBOT_OPENAI_API_KEY=
# CHATBOT_OPENAI_MODEL=gpt-4o-mini
# CHATBOT_LLM_ENABLED=1
# CHATBOT_LLM_TIMEOUT_MS=8000
# CHATBOT_RATE_MAX=30
# CHATBOT_RATE_WINDOW_MS=60000
# CHATBOT_LOG_MAX=5000

# Exports — plafonds
# EXPORT_MAX_ROWS_PER_SHEET=5000
# EXPORT_MAX_FORMATIONS=40
# EXPORT_MAX_FACTURES_HTML=200
# EXPORT_MAX_FACTURE_IDS=200

# ─── reCAPTCHA Enterprise (Google Cloud) — prioritaire si les 3 variables sont définies ───
# Projet GCP : activer l’API "reCAPTCHA Enterprise API", puis créer une clé API (Credentials).
# RECAPTCHA_ENTERPRISE_SITE_KEY = même valeur que la clé affichée dans la console Enterprise (et que VITE_RECAPTCHA_SITE_KEY au build).
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_SITE_KEY=

# Google reCAPTCHA v2 classique (siteverify) — utilisé seulement si Enterprise n’est pas configuré
RECAPTCHA_SECRET_KEY=
# Par défaut, l’IP n’est pas envoyée à Google (évite les échecs derrière nginx si l’IP perçue diffère).
# Mettre à 1 uniquement si vous voulez forcer la validation d’IP côté Google.
RECAPTCHA_VERIFY_SEND_REMOTEIP=0
# 1 = journaliser les error-codes Google en cas d’échec (diagnostic)
RECAPTCHA_DEBUG_LOG=0

ANTI_BOT_REQUIRE_CAPTCHA=false
ANTI_BOT_MIN_FILL_MS=2500
# Inscription : si absent ou != 1, le serveur exige reCAPTCHA configuré (Enterprise ou classique).
# Mettre à 1 uniquement en dev local (frontend sans VITE_RECAPTCHA_SITE_KEY).
# Ne jamais activer en production.
AUTH_INSCRIPTION_BYPASS_CAPTCHA=0

# Verrouillage après échecs de connexion (mémoire process, par IP + email)
LOGIN_LOCKOUT_MAX_FAILURES=8
LOGIN_LOCKOUT_DURATION_MS=900000

# Verrouillage compte en base (après N échecs sur ce compte — persistant après redémarrage)
ACCOUNT_LOCK_MAX_ATTEMPTS=3
ACCOUNT_LOCK_DURATION_MS=900000

# CSP sur les réponses API : 0=désactivé, 1=activé ; en prod activé si SECURITY_CSP non défini
SECURITY_CSP=0

# Antivirus optionnel (ClamAV) — chemin vers clamscan.exe ou binaire
CLAMSCAN_BIN=

# CORS (origines séparées par des virgules)
# CORS_ORIGINS=http://localhost:5173

# ─── Verrou écriture JSON (lowdb) ───
# DB_LOCK_MAX_WAIT_MS=15000

# ─── PM2 : une seule instance (obligatoire avec lowdb) ───
# PM2_INSTANCES=1
# DISABLE_PM2_CLUSTER_WARN=0

# ─── Sauvegardes automatiques ───
# BACKUP_INTERVAL_HOURS=6
# BACKUP_MAX_FILES=80
# BACKUP_UPLOADS_MAX_DIRS=20
# DISABLE_AUTO_BACKUP=0

# ─── Santé / monitoring ───
# HEALTH_MIN_DISK_MB=100

# ─── Mode maintenance (503 sur API hors admin/santé/login) ───
# MAINTENANCE_MODE=0
# MAINTENANCE_MESSAGE=Le portail est en maintenance.

# Reverse proxy (nginx) : 0=désactiver trust proxy, sinon nombre de sauts (défaut 1)
# TRUST_PROXY=1

# ─── E-mail (nodemailer) — vérification du compte + mot de passe oublié par lien ───
# Sans SMTP_HOST : comportement inchangé (pas d’e-mail, inscription directe connectée).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="UniPortail <noreply@votredomaine.com>"
# URL publique du front (liens dans les e-mails)
# PUBLIC_APP_URL=https://votredomaine.com
# 1 = envoyer un e-mail de confirmation à l’inscription ; connexion bloquée tant que non confirmé
# EMAIL_VERIFICATION_ENABLED=1
# 1 = permettre « mot de passe oublié » par e-mail (étudiants)
# PASSWORD_RESET_EMAIL_ENABLED=1
