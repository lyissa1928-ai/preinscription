# Copier vers .env.local (dev) ou .env.production (build prod sur le serveur).
# Ne pas mettre NODE_ENV dans ce fichier : Vite affiche un avertissement et ignore.
VITE_API_URL=
# Inscription : clé site reCAPTCHA (classique ou Enterprise — même valeur que RECAPTCHA_ENTERPRISE_SITE_KEY si Enterprise)
VITE_RECAPTCHA_SITE_KEY=
# Sinon : Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
#
# Dev sans clés ci-dessus : côté backend définir AUTH_INSCRIPTION_BYPASS_CAPTCHA=1 dans backend/.env
# (voir backend/.env.example). Jamais en production.
