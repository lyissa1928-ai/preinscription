# SQLite (development, sans Docker)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production, avec Docker)
# DATABASE_URL="postgresql://gestion:gestion_secret@localhost:5432/gestion_scolaire"

PORT=3000
FRONTEND_URL="http://localhost:3001"

# JWT — OBLIGATOIRE en production (min. 32 caractères, générer une clé aléatoire)
JWT_SECRET="votre-secret-jwt-production-minimum-32-caracteres"
# Durée de vie du token d'accès (ex: 15m, 1h, 24h). En prod, préférer 1h ou moins.
JWT_EXPIRES_IN="1h"
# Durée du refresh token (ex: 7d). Permet de renouveler l'accès sans se reconnecter.
JWT_REFRESH_EXPIRES_IN="7d"

# Optionnel : secret pour la signature des QR codes des badges (sinon valeur par défaut dev)
# BADGE_QR_SECRET="votre-secret-badges"
#
# QR sur le PDF badge : ouvre le pointage enseignant / l’espace étudiant (URL absolue).
# Utilise FRONTEND_URL par défaut, ou surchargez avec :
# BADGE_APP_BASE_URL="https://votre-app.example.com"

# PDF fiche d'inscription : secours si le nom/logo ne sont pas dans Admin → Identité & apparence
# ESTABLISHMENT_NAME="Université / École …"
# ESTABLISHMENT_LOGO_PATH="./assets/establishment-logo.png"
#
# Recommandé : configurer le nom, logo navbar et favicon dans l'UI
# /dashboard/admin/settings/appearance (stockés en base + uploads/appearance/).
